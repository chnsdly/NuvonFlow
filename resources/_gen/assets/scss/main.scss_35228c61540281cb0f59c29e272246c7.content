@charset "UTF-8";
/* ==========================================================================
   Design Tokens
   --------------------------------------------------------------------------
   Shared visual decisions for the site. Keep these tokens restrained:
   industrial, technical, legible, and calm rather than decorative.
   ========================================================================== */
:root {
  /* Color */
  --brand: #0b6f7a;
  --brand-light: #d8ecee;
  --brand-dark: #064b56;
  --accent: #5f7f3a;
  --on-brand: #f8fbf7;
  --surface: #f7f8f4;
  --surface-alt: #eef3ee;
  --on-surface: #162027;
  --muted-text: color-mix(in oklab, var(--on-surface) 62%, var(--surface) 38%);
  --line: #d8ded6;
  --steel: #53636b;
  --card: color-mix(in oklab, var(--surface) 72%, white 28%);
  --img-bg:
    linear-gradient(135deg, #edf5f2 0%, #d7e7e3 46%, #b9d0cf 100%);
  /* Layout */
  --container: 72rem;
  --container-wide: 80rem;
  --container-narrow: 56rem;
  --space: 0.5rem;
  /* Appearance */
  --font-sans: "Inter", "Noto Sans SC", Arial, sans-serif;
  --border: 1px solid var(--line);
  --radius-s: 4px;
  --radius-m: 8px;
  --radius-l: 12px;
  --radius-pill: 999px;
  --shadow:
    0 1px 2px rgba(22, 32, 39, 0.04),
    0 10px 28px rgba(22, 32, 39, 0.06);
  --shadow-hover:
    0 2px 4px rgba(22, 32, 39, 0.05),
    0 14px 32px rgba(22, 32, 39, 0.075);
  --shadow-interactive:
    0 1px 3px rgba(22, 32, 39, 0.045),
    0 12px 28px rgba(22, 32, 39, 0.065);
  --shadow-inset:
    inset 0 1px 0 rgba(255, 255, 255, 0.32),
    inset 0 1px 2px rgba(22, 32, 39, 0.08),
    inset 0 0 0 1px rgba(22, 32, 39, 0.04);
  --header-height: 4.2rem;
  /* Interaction */
  --ease-standard: cubic-bezier(0.22, 0.72, 0.18, 1);
  --ease-out-soft: cubic-bezier(0.16, 1, 0.3, 1);
  --transition-base: 180ms var(--ease-standard);
  --transition-color: 180ms var(--ease-standard);
  --transition-shadow: 220ms var(--ease-standard);
  --transition-transform: 220ms var(--ease-standard);
  --transition-media: 400ms var(--ease-out-soft);
  --interactive-text: color-mix(in oklab, var(--brand) 84%, var(--on-surface) 16%);
  --interactive-border: color-mix(in oklab, var(--brand) 24%, var(--line) 76%);
  --interactive-border-strong: color-mix(in oklab, var(--brand) 42%, var(--line) 58%);
  --interactive-surface: color-mix(in oklab, var(--brand-light) 44%, var(--surface) 56%);
  --interactive-surface-quiet: color-mix(in oklab, var(--brand-light) 28%, var(--surface) 72%);
  --interactive-media-scale: 1.03;
  --focus-outline: 2px solid color-mix(in oklab, var(--brand) 45%, white);
  --focus-offset: 2px;
  /* Layers */
  --z-base: 0;
  --z-header: 10;
  --z-panel: 20;
  --z-modal: 30; }

/* ==========================================================================
   Mixins
   --------------------------------------------------------------------------
   集中管理可复用的 SCSS 工具方法，例如媒体查询、容器宽度、焦点状态、
   文字截断、无障碍动画降级等。

   这里只定义“写样式时可调用的工具”，不直接写具体页面、组件或布局样式。
   ========================================================================== */
/* 响应式断点 */
@font-face {
  font-family: "Inter";
  src: url("/fonts/Inter/InterVariable.ttf") format("truetype");
  font-weight: 400 700;
  font-style: normal;
  font-display: swap; }

@font-face {
  font-family: "Noto Sans SC";
  src: url("/fonts/NotoSansSC/NotoSansSCVariable.ttf") format("truetype");
  font-weight: 400 700;
  font-style: normal;
  font-display: swap; }

/* ==========================================================================
   Reset
   --------------------------------------------------------------------------
   统一浏览器默认样式差异，减少不同浏览器带来的不可控表现。

   这里只做必要的基础重置，例如盒模型、body 默认外边距、媒体元素显示、
   表单字体继承、图片自适应等。不要在这里写品牌视觉、页面布局或组件样式。
   ========================================================================== */
/* 1. 让元素的宽高包含 padding 和 border，布局更好计算 */
*,
*::before,
*::after {
  box-sizing: border-box; }

/* 2. 避免手机浏览器自动把文字放大，减少移动端显示异常 */
html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%; }

/* 3. 去掉页面四周默认空白 */
body {
  margin: 0; }

/* 4. 去掉常见文字元素的默认外边距，避免版面出现不可控空隙
   注意：不动普通 ul / ol，文章里的列表仍然保留缩进和圆点 */
h1,
h2,
h3,
h4,
h5,
h6,
p,
figure,
blockquote,
dl,
dd {
  margin: 0; }

a {
  color: inherit;
  text-decoration: none; }

/* 5. 带 class 的列表通常是导航、卡片、菜单等组件，不需要默认圆点和缩进 */
:where(ul[class], ol[class]) {
  margin: 0;
  padding: 0;
  list-style: none; }

/* 6. 图片、视频等媒体元素不要超出父容器，避免撑破页面 */
img,
picture,
video,
canvas {
  display: block;
  max-width: 100%; }

/* 7. 图片按原比例缩放，不被拉伸变形 */
img {
  height: auto; }

/* 8. 表单里的输入框、按钮等，使用和页面一致的字体 */
input,
button,
textarea,
select {
  font: inherit; }

/* 9. 合并表格边框，方便后续统一控制表格样式 */
table {
  border-collapse: collapse;
  border-spacing: 0; }

/* 10. 文本输入框只允许上下拉伸，避免左右拉伸撑坏布局 */
textarea {
  resize: vertical; }

/* 11. 遇到很长的型号、链接、参数时，允许自动换行，避免出现横向滚动 */
:where(h1, h2, h3, h4, h5, h6, p, a, li, dt, dd, figcaption, th, td) {
  overflow-wrap: break-word; }

/* 12. 键盘操作时保留清晰的焦点提示，方便无障碍访问 */
:focus-visible {
  outline: var(--focus-outline, 2px solid currentColor);
  outline-offset: var(--focus-offset, 2px); }

/* 13. 如果用户系统设置了“减少动态效果”，就尽量关闭动画和过渡 */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important; } }

/* ==========================================================================
   Base
   --------------------------------------------------------------------------
   Site-wide defaults for type, containers, section rhythm, and common helpers.
   ========================================================================== */
body {
  font-family: var(--font-sans);
  font-weight: 400;
  background-color: var(--surface);
  color: var(--on-surface); }

.container {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
  padding-inline: calc(var(--space) * 1); }

.container--wide {
  --container: var(--container-wide); }

.container--narrow {
  --container: var(--container-narrow); }

.font-meta {
  font-size: 0.875rem;
  font-weight: 500; }

.font-body {
  font-size: 1rem;
  font-weight: 400; }

.font-title-xs {
  font-size: 1.25rem;
  font-weight: 500; }

.font-title-s {
  font-size: 1.5rem;
  font-weight: 650; }

.font-title-l {
  font-size: 1.75rem;
  font-weight: 650; }

.font-display {
  font-size: 2rem;
  font-weight: 650; }

.section {
  position: relative;
  padding-block: calc(var(--space) * 4); }

.section__inner {
  display: grid;
  gap: calc(var(--space) * 3); }

.section__header {
  display: grid;
  gap: calc(var(--space) * 2);
  text-align: center; }

.section__title {
  color: var(--on-surface); }

.section__description {
  max-width: 86ch;
  margin: 0 auto;
  color: var(--muted-text); }

.site-header {
  position: sticky;
  top: 0;
  z-index: var(--z-header);
  background-color: var(--surface);
  box-shadow: var(--shadow);
  --site-header-color-transition:
    color var(--transition-color);
  --site-header-toggle-transition:
    background-color var(--transition-color),
    color var(--transition-color); }

.site-header__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  padding: 0 calc(var(--space) * 2);
  gap: calc(var(--space) * 2);
  min-height: var(--header-height); }

.site-header__logo {
  display: inline-flex;
  align-items: center;
  width: 13rem;
  max-width: calc(100vw - 7rem);
  min-width: 0;
  min-height: 2.75rem; }

.site-header__logo:focus-visible {
  border-radius: var(--radius-s); }

.site-header__logo-image {
  display: block;
  width: 100%;
  max-height: 2.75rem;
  object-fit: contain;
  object-position: left center; }

.site-header__toggle {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  justify-self: end;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0.625rem;
  border: 0;
  border-radius: var(--radius-s);
  background-color: var(--surface);
  color: var(--on-surface);
  cursor: pointer;
  transition: var(--site-header-toggle-transition); }

.site-header.is-enhanced .site-header__toggle {
  display: inline-flex; }

.site-header.is-mobile-open .site-header__toggle {
  background-color: var(--brand-light);
  color: var(--brand); }

.site-header.is-mobile-open .site-header__toggle-line:nth-child(1) {
  transform: translateY(7px) rotate(45deg); }

.site-header.is-mobile-open .site-header__toggle-line:nth-child(2) {
  opacity: 0; }

.site-header.is-mobile-open .site-header__toggle-line:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg); }

.site-header__toggle-line {
  display: block;
  flex: 0 0 2px;
  width: 24px;
  height: 2px;
  border-radius: var(--radius-pill);
  background-color: currentColor;
  transform-origin: center;
  transition: opacity var(--transition-color), transform var(--transition-transform); }

.site-header__nav {
  grid-column: 1 / -1;
  display: grid;
  gap: calc(var(--space) * 3);
  padding: 0 0 calc(var(--space) * 2);
  background-color: var(--surface); }

.site-header.is-enhanced .site-header__nav {
  display: none; }

.site-header.is-enhanced.is-mobile-open .site-header__nav {
  position: absolute;
  top: 100%;
  right: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  height: calc(100vh - var(--header-height));
  height: calc(100dvh - var(--header-height));
  max-height: none;
  padding: calc(var(--space) * 2);
  overflow-y: auto;
  overscroll-behavior: contain;
  box-shadow: var(--shadow); }

.site-header__menu {
  display: grid; }

.site-header.is-enhanced.is-mobile-open .site-header__menu {
  align-content: start; }

.site-header__item {
  padding-block: calc(var(--space) * 0.5); }

.site-header__item-control {
  display: flex;
  align-items: stretch;
  gap: calc(var(--space) * 0.5);
  min-width: 0; }

.site-header__link {
  appearance: none;
  display: inline-flex;
  align-items: center;
  flex: 1 1 auto;
  min-width: 0;
  min-height: 2.75rem;
  padding: calc(var(--space) * 1) calc(var(--space) * 1.25);
  border: 0;
  border-radius: var(--radius-s);
  background-color: transparent;
  box-shadow: none;
  color: var(--on-surface);
  cursor: pointer;
  font: inherit;
  line-height: inherit;
  outline: none;
  text-align: left;
  transition: var(--site-header-color-transition); }

.site-header__link--toggle {
  justify-content: space-between;
  gap: calc(var(--space) * 0.75);
  width: 100%; }

.site-header__link--parent {
  display: none; }

button.site-header__link::-moz-focus-inner {
  padding: 0;
  border: 0; }

.site-header__link:hover,
.site-header__link:focus-visible,
.site-header__item.is-active > .site-header__item-control .site-header__link {
  color: var(--interactive-text); }

.site-header__link:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.site-header__chevron {
  color: currentColor;
  font-size: 0.85em;
  line-height: 1;
  transition: transform var(--transition-transform); }

.site-header__item.is-submenu-open .site-header__chevron {
  transform: rotate(180deg); }

.site-header__submenu {
  display: grid;
  padding: calc(var(--space) * 0.5) calc(var(--space) * 1) calc(var(--space) * 1.5) calc(var(--space) * 2); }

.site-header__submenu--mega {
  gap: calc(var(--space) * 1.5); }

.site-header__mega-intro,
.site-header__mega-section,
.site-header__mega-visual {
  display: grid;
  align-content: start;
  gap: calc(var(--space) * 0.75);
  min-width: 0; }

.site-header__mega-intro {
  padding: calc(var(--space) * 1.25) calc(var(--space) * 1) calc(var(--space) * 0.75); }

.site-header__mega-kicker,
.site-header__mega-section-title,
.site-header__mega-visual-kicker {
  color: var(--brand); }

.site-header__mega-title,
.site-header__mega-visual-title {
  color: var(--on-surface);
  padding-top: calc(var(--space) * 1.25);
  font-size: 1.25rem;
  font-weight: 400;
  line-height: 1.35; }

.site-header__mega-text,
.site-header__mega-visual-text {
  color: var(--muted-text);
  font-size: 0.95rem;
  line-height: 1.55; }

.site-header__mega-overview {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 2.5rem;
  padding: calc(var(--space) * 0.5) calc(var(--space) * 1);
  border-radius: var(--radius-s);
  color: var(--brand);
  font-weight: 600;
  transition: var(--site-header-color-transition); }

.site-header__mega-overview:hover,
.site-header__mega-overview:focus-visible,
.site-header__mega-overview[aria-current="page"] {
  color: var(--interactive-text); }

.site-header__mega-list {
  display: grid;
  grid-auto-rows: max-content;
  align-content: start; }

.site-header__mega-visual {
  border: var(--border);
  border-radius: var(--radius-m);
  background-color: color-mix(in oklab, var(--brand-light) 30%, var(--surface) 70%);
  overflow: hidden; }

.site-header__mega-visual-link {
  display: grid;
  align-content: start;
  gap: calc(var(--space) * 0.75);
  height: 100%;
  padding: calc(var(--space) * 1.5);
  border-radius: inherit;
  color: inherit;
  text-decoration: none; }

.site-header__mega-visual-link:focus-visible {
  outline: var(--focus-outline);
  outline-offset: calc(var(--focus-offset) * -1); }

.site-header__mega-visual-cta {
  align-self: end;
  margin-top: auto;
  color: var(--brand);
  font-size: 0.92rem;
  font-weight: 700; }

.site-header__submenu-link {
  position: relative;
  display: block;
  padding: calc(var(--space) * 1.25) calc(var(--space) * 1);
  border-radius: var(--radius-s);
  color: var(--muted-text);
  font-size: 0.95rem;
  transition: color var(--transition-color); }

.site-header__submenu-link--plain {
  padding-block: calc(var(--space) * 1);
  padding-inline: calc(var(--space) * 1);
  border: 1px solid transparent;
  color: var(--muted-text); }

.site-header__submenu-link--entry,
.site-header__submenu-link--described {
  display: grid;
  gap: calc(var(--space) * 0.4);
  padding-block: calc(var(--space) * 1);
  padding-inline: calc(var(--space) * 1);
  border: 1px solid transparent;
  white-space: normal; }

.site-header__submenu-link--entry .site-header__submenu-link-title,
.site-header__submenu-link--described .site-header__submenu-link-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--space) * 0.75);
  color: color-mix(in oklab, var(--on-surface) 90%, var(--brand) 10%);
  font-weight: 400; }

.site-header__submenu-link--entry .site-header__submenu-link-title::after,
.site-header__submenu-link--described .site-header__submenu-link-title::after {
  flex: 0 0 auto;
  color: var(--interactive-text);
  content: "\2192";
  font-size: 0.9rem;
  line-height: 1;
  opacity: 0.5;
  transform: translateX(-0.15rem);
  transition: opacity var(--transition-color), transform var(--transition-transform); }

.site-header__submenu-link-description {
  color: var(--muted-text);
  font-size: 0.8rem;
  font-weight: 400;
  line-height: 1.42; }

.site-header__submenu-link--plain:hover,
.site-header__submenu-link--plain:focus-visible,
.site-header__submenu-link--plain[aria-current="page"],
.site-header__submenu-link--entry:hover,
.site-header__submenu-link--entry:focus-visible,
.site-header__submenu-link--entry[aria-current="page"],
.site-header__submenu-link--described:hover,
.site-header__submenu-link--described:focus-visible,
.site-header__submenu-link--described[aria-current="page"] {
  color: var(--interactive-text); }

.site-header__submenu-link--entry:hover .site-header__submenu-link-title,
.site-header__submenu-link--entry:focus-visible .site-header__submenu-link-title,
.site-header__submenu-link--entry[aria-current="page"] .site-header__submenu-link-title,
.site-header__submenu-link--described:hover .site-header__submenu-link-title,
.site-header__submenu-link--described:focus-visible .site-header__submenu-link-title,
.site-header__submenu-link--described[aria-current="page"] .site-header__submenu-link-title {
  color: var(--interactive-text); }

.site-header__submenu-link--entry:hover .site-header__submenu-link-title::after,
.site-header__submenu-link--entry:focus-visible .site-header__submenu-link-title::after,
.site-header__submenu-link--entry[aria-current="page"] .site-header__submenu-link-title::after,
.site-header__submenu-link--described:hover .site-header__submenu-link-title::after,
.site-header__submenu-link--described:focus-visible .site-header__submenu-link-title::after,
.site-header__submenu-link--described[aria-current="page"] .site-header__submenu-link-title::after {
  opacity: 1;
  transform: translateX(0.1rem); }

.site-header__submenu-link--described:hover .site-header__submenu-link-description,
.site-header__submenu-link--described:focus-visible .site-header__submenu-link-description,
.site-header__submenu-link--described[aria-current="page"] .site-header__submenu-link-description {
  color: color-mix(in oklab, var(--interactive-text) 70%, var(--muted-text) 30%); }

.site-header__nav-footer {
  display: grid;
  gap: calc(var(--space) * 1.5);
  padding-top: calc(var(--space) * 1.5);
  border-top: var(--border); }

.site-header.is-enhanced.is-mobile-open .site-header__nav-footer {
  margin-top: auto; }

.site-header__language {
  display: grid;
  gap: calc(var(--space) * 0.75); }

.site-header__language-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75); }

.site-header__language-link {
  display: inline-flex;
  align-items: center;
  min-height: 2rem;
  padding: calc(var(--space) * 0.35) calc(var(--space) * 0.75);
  border: 1px solid transparent;
  border-radius: var(--radius-pill);
  background-color: transparent;
  color: var(--muted-text);
  font-size: 0.95rem;
  transition: color var(--transition-color); }

.site-header__language-link:hover,
.site-header__language-link:focus-visible,
.site-header__language-link.is-active {
  color: var(--interactive-text); }

.site-header__actions {
  display: none; }

.site-header__language-switcher {
  position: relative; }

.site-header__language-current {
  display: inline-flex;
  align-items: center;
  gap: calc(var(--space) * 0.45);
  min-height: 2.5rem;
  padding: calc(var(--space) * 0.45) calc(var(--space) * 0.65);
  border: 1px solid transparent;
  border-radius: var(--radius-s);
  background-color: transparent;
  color: var(--muted-text);
  cursor: pointer;
  font-size: 0.88rem;
  font-weight: 600;
  list-style: none;
  white-space: nowrap;
  transition: color var(--transition-color); }

.site-header__language-current::-webkit-details-marker {
  display: none; }

.site-header__language-current::after {
  color: var(--muted-text);
  content: "\25BE";
  font-size: 0.75rem;
  line-height: 1; }

.site-header__language-current:hover,
.site-header__language-current:focus-visible,
.site-header__language-switcher[open] .site-header__language-current {
  color: var(--interactive-text); }

.site-header__language-current:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.site-header__language-current-label {
  max-width: 4rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; }

.site-header__language-menu {
  position: absolute;
  top: calc(100% + 0.55rem);
  right: 0;
  z-index: var(--z-panel);
  display: grid;
  width: max-content;
  min-width: 100%;
  max-width: 18rem;
  padding: calc(var(--space) * 0.65);
  border: var(--border);
  border-radius: var(--radius-m);
  background-color: var(--surface);
  box-shadow: var(--shadow-hover); }

.site-header__language-menu-link {
  display: flex;
  align-items: center;
  gap: calc(var(--space) * 0.75);
  min-height: 2.6rem;
  padding: calc(var(--space) * 0.65) calc(var(--space) * 0.7);
  border-radius: var(--radius-s);
  color: var(--on-surface);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: color var(--transition-color); }

.site-header__language-menu-link::before {
  display: inline-flex;
  justify-content: center;
  width: 1rem;
  color: var(--brand);
  content: ""; }

.site-header__language-menu-link.is-active::before {
  content: "\2713"; }

.site-header__language-menu-link span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis; }

.site-header__language-menu-link:hover,
.site-header__language-menu-link:focus-visible,
.site-header__language-menu-link.is-active {
  color: var(--interactive-text); }

@media (max-width: 63.999rem) {
  .site-header.is-enhanced .site-header__item--has-children:not(.is-submenu-open) > .site-header__submenu {
    display: none; } }

@media (min-width: 64rem) {
  .site-header__inner {
    grid-template-columns: minmax(10rem, 0.9fr) auto minmax(10rem, 0.9fr);
    padding-inline: calc(var(--space) * 2); }
  .site-header.is-enhanced .site-header__toggle {
    display: none; }
  .site-header__nav,
  .site-header.is-enhanced .site-header__nav,
  .site-header.is-enhanced.is-mobile-open .site-header__nav {
    position: static;
    grid-column: auto;
    display: block;
    justify-self: center;
    height: auto;
    max-height: none;
    padding: 0;
    overflow: visible;
    overscroll-behavior: auto;
    box-shadow: none; }
  .site-header__menu {
    display: flex;
    align-items: center;
    height: var(--header-height);
    gap: calc(var(--space) * 1); }
  .site-header__item {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: 0;
    height: 100%; }
  .site-header__item--mega {
    position: static; }
  .site-header__item-control {
    align-items: center;
    gap: 0;
    height: 100%; }
  .site-header__link {
    flex: 0 0 auto;
    padding: calc(var(--space) * 0.75) calc(var(--space) * 1);
    white-space: nowrap; }
  .site-header__link--toggle {
    display: none;
    justify-content: flex-start;
    gap: calc(var(--space) * 0.5);
    width: auto; }
  .site-header__link--parent {
    display: inline-flex;
    justify-content: flex-start;
    gap: calc(var(--space) * 0.5); }
  .site-header__item--has-children:hover .site-header__chevron,
  .site-header__item--has-children:focus-within .site-header__chevron {
    transform: rotate(180deg); }
  .site-header__submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: var(--z-panel);
    min-width: 16rem;
    padding: calc(var(--space) * 1.5);
    border-radius: var(--radius-m);
    background-color: var(--surface);
    box-shadow: var(--shadow-hover);
    opacity: 0;
    transform: translate(-50%, -0.25rem);
    visibility: hidden;
    transition: opacity var(--transition-color), transform var(--transition-transform); }
  .site-header__item--has-children:hover > .site-header__submenu,
  .site-header__item--has-children:focus-within > .site-header__submenu,
  .site-header__item.is-submenu-open > .site-header__submenu {
    opacity: 1;
    transform: translate(-50%, 0);
    visibility: visible; }
  .site-header__submenu-link {
    padding: calc(var(--space) * 1.5) calc(var(--space) * 1);
    white-space: nowrap; }
  .site-header__submenu--mega {
    right: 0;
    left: 0;
    width: 100%;
    min-width: 0;
    grid-template-columns: minmax(15rem, 0.95fr) minmax(13rem, 0.9fr) minmax(14rem, 0.95fr) minmax(16rem, 1fr);
    gap: calc(var(--space) * 2);
    align-items: stretch;
    padding: calc(var(--space) * 2) 4vw;
    border-radius: 0;
    transform: translateY(-0.25rem); }
  .site-header__item--mega:hover > .site-header__submenu--mega,
  .site-header__item--mega:focus-within > .site-header__submenu--mega,
  .site-header__item--mega.is-submenu-open > .site-header__submenu--mega {
    transform: translateY(0); }
  .site-header__submenu--mega .site-header__submenu-link {
    padding: calc(var(--space) * 1.25) calc(var(--space) * 1);
    white-space: normal; }
  .site-header__mega-intro {
    padding: calc(var(--space) * 0.5) 0; }
  .site-header__mega-section {
    padding-top: calc(var(--space) * 0.5); }
  .site-header__mega-visual {
    min-height: 13rem; }
  .site-header__mega-visual-link {
    padding-block: calc(var(--space) * 0.5) calc(var(--space) * 1.5); }
  .site-header__nav-footer {
    display: none; }
  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: calc(var(--space) * 1);
    min-width: 0; }
  .site-header__cta.button {
    display: inline-flex;
    white-space: nowrap; } }

@media (min-width: 80rem) {
  .site-header__inner {
    grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr);
    padding-inline: calc(var(--space) * 2); }
  .site-header__menu {
    gap: calc(var(--space) * 2); } }

.site-footer {
  padding-block: calc(var(--space) * 5) calc(var(--space) * 3);
  border-top: var(--border);
  background-color: color-mix(in oklab, var(--on-surface) 94%, var(--brand) 6%);
  color: color-mix(in oklab, white 82%, var(--brand-light) 18%); }

.site-footer__grid {
  display: grid;
  gap: calc(var(--space) * 3); }

.site-footer__brand {
  display: grid;
  gap: calc(var(--space) * 1.25); }

.site-footer__logo {
  display: inline-flex;
  align-items: center;
  width: 16rem;
  max-width: 100%;
  padding: calc(var(--space) * 0.65) calc(var(--space) * 0.85);
  border-radius: var(--radius-s);
  background-color: var(--surface); }

.site-footer__logo-image {
