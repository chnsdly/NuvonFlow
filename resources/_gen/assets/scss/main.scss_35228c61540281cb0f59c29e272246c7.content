  max-height: 3.5rem;
  object-fit: contain;
  object-position: left center; }

.site-footer__title,
.site-footer__heading {
  color: white; }

.site-footer__title {
  font-size: 1.35rem;
  line-height: 1.3; }

.site-footer__heading {
  margin-bottom: calc(var(--space) * 1);
  font-size: 1rem; }

.site-footer__text,
.site-footer__list,
.site-footer__bottom {
  color: color-mix(in oklab, white 72%, var(--brand-light) 28%); }

.site-footer__list {
  display: grid;
  gap: calc(var(--space) * 0.75); }

.site-footer a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-color); }

.site-footer a:hover,
.site-footer a:focus-visible {
  color: white; }

.site-footer__bottom {
  display: grid;
  gap: calc(var(--space) * 1.5);
  margin-top: calc(var(--space) * 4);
  padding-top: calc(var(--space) * 2);
  border-top: 1px solid rgba(255, 255, 255, 0.14);
  font-size: 0.9rem; }

.site-footer__legal {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 1.25); }

@media (min-width: 48rem) {
  .site-footer__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .site-footer__bottom {
    grid-template-columns: 1fr auto;
    align-items: center; } }

@media (min-width: 64rem) {
  .site-footer__grid {
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(10rem, 1fr)); } }

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: calc(var(--space) * 0.75);
  min-height: 2.75rem;
  padding: calc(var(--space) * 0.75) calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-s);
  font: inherit;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  vertical-align: middle;
  appearance: none;
  user-select: none;
  cursor: pointer;
  transition: background-color var(--transition-color), border-color var(--transition-color), box-shadow var(--transition-shadow), color var(--transition-color), opacity var(--transition-color), transform var(--transition-transform); }

.button:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.button:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):active {
  transform: translateY(1px); }

.button:disabled,
.button[aria-disabled="true"],
.button.is-disabled {
  box-shadow: none;
  cursor: not-allowed;
  opacity: 0.55;
  pointer-events: none;
  transform: none; }

.button__icon,
.button > svg {
  display: inline-flex;
  flex: 0 0 auto;
  width: 1.125em;
  height: 1.125em; }

.button__icon svg {
  display: block;
  width: 100%;
  height: 100%; }

.button__text {
  min-width: 0; }

.button--primary {
  border-color: var(--brand);
  background-color: var(--brand);
  color: var(--on-brand);
  box-shadow: var(--shadow-inset); }

.button--primary:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):hover {
  border-color: color-mix(in oklab, var(--brand) 84%, var(--on-surface) 16%);
  background-color: color-mix(in oklab, var(--brand) 88%, var(--on-surface) 12%);
  color: var(--on-brand);
  box-shadow: var(--shadow-interactive); }

.button--secondary {
  border-color: color-mix(in oklab, var(--brand) 42%, var(--surface) 58%);
  background-color: color-mix(in oklab, var(--surface) 92%, white 8%);
  color: var(--brand); }

.button--secondary:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):hover {
  border-color: var(--interactive-border-strong);
  background-color: var(--interactive-surface-quiet);
  color: var(--interactive-text); }

.button--full {
  width: 100%; }

.feature-grid,
.content-card-grid {
  display: grid;
  gap: calc(var(--space) * 2);
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }

.products-list__grid {
  display: grid;
  gap: calc(var(--space) * 2);
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }

.products-list__grid--media {
  grid-template-columns: 1fr; }

.case-studies-list__grid,
.insights-list__list {
  display: grid;
  gap: calc(var(--space) * 2);
  grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  padding-left: 0;
  list-style: none; }

.feature-card,
.content-card,
.products-list__card,
.case-studies-list__card,
.insights-list__card {
  display: grid;
  gap: calc(var(--space) * 1.25);
  height: 100%;
  padding: calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background-color: var(--card);
  color: inherit;
  text-decoration: none;
  transition: border-color var(--transition-color), box-shadow var(--transition-shadow); }

.content-card:hover,
.content-card:focus-visible,
.products-list__card:hover,
.products-list__card:focus-visible,
.case-studies-list__card:hover,
.case-studies-list__card:focus-visible,
.insights-list__card:hover,
.insights-list__card:focus-visible {
  border-color: var(--interactive-border);
  box-shadow: var(--shadow-interactive); }

.products-list__grid--media .products-list__card {
  align-content: start;
  gap: calc(var(--space) * 1.25);
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  box-shadow: none;
  grid-template-rows: auto auto; }

.products-list__grid--media .products-list__card:hover,
.products-list__grid--media .products-list__card:focus-visible {
  box-shadow: none; }

.feature-card__title,
.content-card__title,
.products-list__title,
.case-studies-list__title,
.insights-list__title {
  color: var(--on-surface);
  line-height: 1.25; }

.content-card__title,
.products-list__title,
.case-studies-list__title,
.insights-list__title {
  transition: color var(--transition-color); }

.content-card__title::after,
.case-studies-list__title::after,
.insights-list__title::after {
  display: inline-block;
  margin-left: calc(var(--space) * 0.6);
  color: var(--interactive-text);
  content: "\2192";
  font-size: 0.86em;
  line-height: 1;
  opacity: 0.48;
  transform: translateX(-0.15rem);
  transition: opacity var(--transition-color), transform var(--transition-transform); }

.content-card:hover .content-card__title,
.content-card:focus-visible .content-card__title,
.products-list__card:hover .products-list__title,
.products-list__card:focus-visible .products-list__title,
.case-studies-list__card:hover .case-studies-list__title,
.case-studies-list__card:focus-visible .case-studies-list__title,
.insights-list__card:hover .insights-list__title,
.insights-list__card:focus-visible .insights-list__title {
  color: var(--interactive-text); }

.content-card:hover .content-card__title::after,
.content-card:focus-visible .content-card__title::after,
.case-studies-list__card:hover .case-studies-list__title::after,
.case-studies-list__card:focus-visible .case-studies-list__title::after,
.insights-list__card:hover .insights-list__title::after,
.insights-list__card:focus-visible .insights-list__title::after {
  opacity: 1;
  transform: translateX(0.1rem); }

.feature-card__text,
.content-card__text,
.products-list__text,
.case-studies-list__excerpt,
.insights-list__excerpt {
  color: var(--muted-text); }

.content-card__kicker {
  color: var(--brand);
  font-weight: 700;
  text-transform: uppercase; }

.products-list__media,
.case-studies-list__media,
.insights-list__media {
  overflow: hidden;
  margin: calc(var(--space) * -2) calc(var(--space) * -2) 0;
  border-radius: var(--radius-m) var(--radius-m) 0 0;
  background: var(--img-bg); }

.products-list__media {
  margin: 0;
  border: var(--border);
  border-radius: var(--radius-m);
  aspect-ratio: 1 / 1;
  box-shadow: var(--shadow);
  transition: border-color var(--transition-color), box-shadow var(--transition-shadow); }

.products-list__grid--media .products-list__card:hover .products-list__media,
.products-list__grid--media .products-list__card:focus-visible .products-list__media {
  border-color: var(--interactive-border);
  box-shadow: var(--shadow-interactive); }

.case-studies-list__media,
.insights-list__media {
  aspect-ratio: 16 / 8; }

.products-list__media .technical-visual,
.case-studies-list__media .technical-visual,
.insights-list__media .technical-visual {
  height: 100%;
  min-height: 100%; }

.products-list__image,
.case-studies-list__image,
.insights-list__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1);
  transform-origin: center;
  transition: transform var(--transition-media); }

.products-list__media .technical-visual,
.case-studies-list__media .technical-visual,
.insights-list__media .technical-visual {
  transform: scale(1);
  transform-origin: center;
  transition: transform var(--transition-media); }

.products-list__card:hover .products-list__image,
.products-list__card:focus-visible .products-list__image,
.products-list__card:hover .products-list__media .technical-visual,
.products-list__card:focus-visible .products-list__media .technical-visual,
.case-studies-list__card:hover .case-studies-list__image,
.case-studies-list__card:focus-visible .case-studies-list__image,
.case-studies-list__card:hover .case-studies-list__media .technical-visual,
.case-studies-list__card:focus-visible .case-studies-list__media .technical-visual,
.insights-list__card:hover .insights-list__image,
.insights-list__card:focus-visible .insights-list__image,
.insights-list__card:hover .insights-list__media .technical-visual,
.insights-list__card:focus-visible .insights-list__media .technical-visual {
  transform: scale(var(--interactive-media-scale)); }

.products-list__content,
.case-studies-list__content,
.insights-list__content {
  display: grid;
  align-content: start;
  gap: calc(var(--space) * 1); }

.products-list__grid--media .products-list__content {
  justify-items: center;
  text-align: center; }

.products-list__grid--media .products-list__text {
  max-width: 34ch; }

.products-list__grid--media .tag-list {
  justify-content: center; }

.products-list__grid--media .tag-list li {
  min-height: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent; }

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75); }

.tag-list li {
  display: inline-flex;
  align-items: center;
  min-height: 1.875rem;
  padding: calc(var(--space) * 0.35) calc(var(--space) * 0.75);
  border: var(--border);
  border-radius: var(--radius-pill);
  background-color: color-mix(in oklab, var(--brand-light) 28%, var(--surface) 72%);
  color: color-mix(in oklab, var(--brand) 82%, var(--on-surface) 18%);
  font-size: 0.875rem;
  line-height: 1.2; }

.technical-visual {
  position: relative;
  isolation: isolate;
  display: grid;
  align-items: end;
  min-height: 100%;
  overflow: hidden;
  padding: calc(var(--space) * 1.5);
  background: linear-gradient(135deg, #08242a 0%, #0f3c43 52%, #28574e 100%);
  color: white; }

.technical-visual__grid,
.technical-visual__line,
.technical-visual__node,
.technical-visual__gauge,
.technical-visual__shape {
  position: absolute;
  z-index: -1; }

.technical-visual__grid {
  inset: 0;
  background-image: linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
  background-size: 1.5rem 1.5rem;
  mask-image: linear-gradient(135deg, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.25)); }

.technical-visual__line {
  height: 0.25rem;
  border-radius: var(--radius-pill);
  background-color: color-mix(in oklab, var(--brand-light) 72%, white 28%);
  box-shadow: 0 0 18px rgba(18, 121, 232, 0.28); }

.technical-visual__line--main {
  right: 11%;
  bottom: 43%;
  left: 11%; }

.technical-visual__line--branch {
  right: 28%;
  bottom: 43%;
  width: 28%;
  transform: rotate(-32deg);
  transform-origin: right center; }

.technical-visual__node {
  width: 1.15rem;
  height: 1.15rem;
  border: 2px solid color-mix(in oklab, var(--brand-light) 62%, white 38%);
  border-radius: var(--radius-s);
  background-color: #0a2a30; }

.technical-visual__node--inlet {
  bottom: calc(43% - 0.45rem);
  left: 10%; }

.technical-visual__node--valve {
  bottom: calc(43% - 0.45rem);
  left: 47%;
  transform: rotate(45deg); }

.technical-visual__node--outlet {
  right: 10%;
  bottom: calc(43% - 0.45rem); }

.technical-visual__gauge {
  display: block;
  width: 3.25rem;
  height: 2rem;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: var(--radius-s);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.04)); }

.technical-visual__gauge--pressure {
  top: 18%;
  right: 14%; }

.technical-visual__gauge--document {
  top: 28%;
  left: 15%; }

.technical-visual__legend {
  display: grid;
  gap: calc(var(--space) * 0.35);
  max-width: 18rem;
  color: white; }

.technical-visual__legend span {
  color: color-mix(in oklab, var(--brand-light) 80%, white 20%);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase; }

.technical-visual__legend strong {
  font-size: 1.1rem;
  line-height: 1.25; }

.technical-visual__shape {
  display: none;
  border: 1px solid rgba(255, 255, 255, 0.34);
  background-color: rgba(255, 255, 255, 0.1); }

.technical-visual--single,
.technical-visual--application,
.technical-visual--article {
  min-height: 18rem; }

.technical-visual--card {
  min-height: 11rem;
  padding: calc(var(--space) * 1.25); }

.technical-visual--card .technical-visual__legend strong {
  font-size: 1rem; }

.technical-visual--ball-valves .technical-visual__node--valve {
  border-radius: 50%;
  transform: none; }

.technical-visual--ball-valves .technical-visual__shape--primary {
  display: block;
  left: calc(47% + 0.18rem);
  bottom: calc(43% - 0.18rem);
  width: 0.8rem;
  height: 0.18rem;
  border: 0;
  border-radius: var(--radius-pill);
  background-color: color-mix(in oklab, var(--brand-light) 80%, white 20%);
  transform: rotate(32deg); }

.technical-visual--butterfly-valves .technical-visual__node--valve {
  width: 1.4rem;
  height: 1.4rem;
  border-radius: 50%;
  transform: none; }

.technical-visual--butterfly-valves .technical-visual__shape--primary {
  display: block;
  left: calc(47% + 0.55rem);
  bottom: calc(43% - 1.25rem);
  width: 0.28rem;
  height: 2.5rem;
  border: 0;
  border-radius: var(--radius-pill);
  background-color: color-mix(in oklab, var(--brand-light) 78%, white 22%);
  transform: rotate(-18deg); }

.technical-visual--diaphragm-valves .technical-visual__node--valve {
  width: 2.1rem;
  border-radius: 0.35rem 0.35rem 1rem 1rem;
  transform: none; }

.technical-visual--diaphragm-valves .technical-visual__shape--primary {
  display: block;
  left: calc(47% - 0.15rem);
  bottom: calc(43% + 0.3rem);
  width: 2.6rem;
  height: 1.2rem;
  border-radius: 2rem 2rem 0.25rem 0.25rem; }

.technical-visual--check-valves .technical-visual__shape--primary {
  display: block;
  right: 30%;
  bottom: calc(43% - 0.7rem);
  width: 0;
  height: 0;
  border-top: 0.75rem solid transparent;
  border-bottom: 0.75rem solid transparent;
  border-left: 1.25rem solid color-mix(in oklab, var(--brand-light) 75%, white 25%);
  background: transparent; }

.technical-visual--check-valves .technical-visual__shape--secondary {
  display: block;
  right: 27%;
  bottom: calc(43% - 1rem);
  width: 0.18rem;
  height: 2rem;
  border: 0;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.42); }

.technical-visual--pressure-control-chemfeed .technical-visual__line--branch,
.technical-visual--chemical-dosing-injection .technical-visual__line--branch {
  right: 34%;
  width: 22%;
  transform: rotate(-58deg); }

.technical-visual--pressure-control-chemfeed .technical-visual__shape--primary,
.technical-visual--chemical-dosing-injection .technical-visual__shape--primary {
  display: block;
  right: 36%;
  bottom: 58%;
  width: 2.8rem;
  height: 3.6rem;
  border-radius: 0.4rem 0.4rem 1.4rem 1.4rem; }

.technical-visual--pressure-control-chemfeed .technical-visual__shape--secondary,
.technical-visual--chemical-dosing-injection .technical-visual__shape--secondary {
  display: block;
  right: 23%;
  top: 20%;
  width: 4rem;
  height: 2.4rem;
  border-radius: var(--radius-s); }

.technical-visual--actuators .technical-visual__shape--primary {
  display: block;
  left: calc(47% - 0.55rem);
  bottom: calc(43% + 1.2rem);
  width: 2.7rem;
  height: 2rem;
  border-radius: var(--radius-s); }

.technical-visual--actuators .technical-visual__shape--secondary {
  display: block;
  left: calc(47% + 0.62rem);
  bottom: calc(43% + 0.65rem);
  width: 0.26rem;
  height: 0.8rem;
  border: 0;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.42); }

.technical-visual--fittings .technical-visual__line--branch {
  right: 47%;
  width: 22%;
  transform: rotate(-90deg); }

.technical-visual--fittings .technical-visual__shape--primary,
.technical-visual--fittings .technical-visual__shape--secondary {
  display: block;
  bottom: calc(43% - 0.55rem);
  width: 1rem;
  height: 1rem;
  border-radius: 50%; }

.technical-visual--fittings .technical-visual__shape--primary {
  left: 35%; }

.technical-visual--fittings .technical-visual__shape--secondary {
  right: 28%; }

.technical-visual--document .technical-visual__shape--primary,
.technical-visual--case .technical-visual__shape--primary,
.technical-visual--insight .technical-visual__shape--primary,
.technical-visual--about .technical-visual__shape--primary {
  display: block;
  top: 18%;
  right: 14%;
  width: 5rem;
  height: 6.5rem;
  border-radius: var(--radius-s); }

.technical-visual--document .technical-visual__shape--primary::before,
.technical-visual--case .technical-visual__shape--primary::before,
.technical-visual--insight .technical-visual__shape--primary::before,
.technical-visual--about .technical-visual__shape--primary::before,
.technical-visual--document .technical-visual__shape--primary::after,
.technical-visual--case .technical-visual__shape--primary::after,
.technical-visual--insight .technical-visual__shape--primary::after,
.technical-visual--about .technical-visual__shape--primary::after {
  position: absolute;
  right: 0.8rem;
  left: 0.8rem;
  height: 0.25rem;
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.34);
  content: ""; }

.technical-visual--document .technical-visual__shape--primary::before,
.technical-visual--case .technical-visual__shape--primary::before,
.technical-visual--insight .technical-visual__shape--primary::before,
.technical-visual--about .technical-visual__shape--primary::before {
  top: 1.4rem; }

.technical-visual--document .technical-visual__shape--primary::after,
.technical-visual--case .technical-visual__shape--primary::after,
.technical-visual--insight .technical-visual__shape--primary::after,
.technical-visual--about .technical-visual__shape--primary::after {
  top: 2.3rem;
  right: 1.7rem; }

@media (min-width: 48rem) {
  .products-list__grid--media {
    grid-template-columns: repeat(2, minmax(0, 1fr)); } }

@media (min-width: 64rem) {
  .products-list__grid--media {
    grid-template-columns: repeat(3, minmax(0, 1fr)); } }

.inquiry-form {
  display: grid;
  gap: calc(var(--space) * 2); }

.inquiry-form__grid {
  display: grid;
  gap: calc(var(--space) * 1.35) calc(var(--space) * 1.5); }

.inquiry-form__field {
  display: grid;
  gap: calc(var(--space) * 0.75); }

.inquiry-form__label {
  color: var(--on-surface);
  font-size: 0.95rem;
  font-weight: 600; }

.inquiry-form__control {
  width: 100%;
  min-height: 2.875rem;
  padding: calc(var(--space) * 0.85) calc(var(--space) * 1);
  border: var(--border);
  border-radius: var(--radius-s);
  background-color: white;
  color: var(--on-surface);
  font: inherit;
  transition: border-color var(--transition-color), box-shadow var(--transition-shadow); }

.inquiry-form__control::placeholder {
  color: color-mix(in oklab, var(--muted-text) 58%, white 42%);
  opacity: 1; }

.inquiry-form__control:focus {
  border-color: var(--interactive-border-strong);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 18%, transparent);
  outline: none; }

.inquiry-form__control--textarea {
  min-height: 9rem;
  resize: vertical; }

.inquiry-form__note {
  color: var(--muted-text);
  font-size: 0.925rem;
  line-height: 1.6; }

@media (min-width: 48rem) {
  .inquiry-form__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .inquiry-form__field--full {
    grid-column: 1 / -1; } }

.breadcrumbs {
  padding-block: calc(var(--space) * 1);
  border-bottom: var(--border); }

.breadcrumbs__list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75);
  color: var(--muted-text); }

.breadcrumbs__item {
  display: inline-flex;
  align-items: center;
  min-width: 0; }

.breadcrumbs__item + .breadcrumbs__item::before {
  content: "›";
  margin-right: calc(var(--space) * 0.75);
  color: color-mix(in oklab, var(--muted-text) 70%, var(--surface) 30%); }

.breadcrumbs__link,
.breadcrumbs__current {
  font-size: 0.875rem;
  line-height: 1.4; }

.breadcrumbs__link {
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-s);
  color: inherit;
  transition: color var(--transition-color); }

.breadcrumbs__link:hover,
.breadcrumbs__link:focus-visible {
  color: var(--interactive-text); }

.breadcrumbs__link:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.breadcrumbs__link[aria-disabled="true"],
.breadcrumbs__link:disabled,
.breadcrumbs__link--disabled {
  opacity: 0.5;
  pointer-events: none; }

.breadcrumbs__current {
  color: var(--on-surface);
  font-weight: 500;
  overflow-wrap: anywhere; }

.home-hero {
  position: relative;
  isolation: isolate;
  min-height: 34rem;
  display: grid;
  align-items: center;
  overflow: hidden;
  background-color: color-mix(in oklab, var(--brand) 30%, var(--on-surface) 70%); }

.home-hero__bg {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover; }

.home-hero__technical {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  pointer-events: none;
  background: radial-gradient(circle at 74% 42%, rgba(78, 194, 190, 0.22), transparent 34%), radial-gradient(circle at 98% 72%, rgba(95, 127, 58, 0.2), transparent 30%), linear-gradient(135deg, #06171d 0%, #0a2c34 48%, #153c3f 100%); }

.home-hero__technical::before,
.home-hero__technical::after {
  position: absolute;
  inset: 0;
  content: ""; }

.home-hero__technical::before {
  background-image: linear-gradient(rgba(219, 247, 246, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(219, 247, 246, 0.07) 1px, transparent 1px);
  background-size: 2rem 2rem;
  opacity: 0.72; }

.home-hero__technical::after {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 18%), linear-gradient(0deg, rgba(3, 18, 25, 0.22), transparent 42%); }

.home-hero-system {
  position: absolute;
  top: 50%;
  right: max(4.25rem, calc((100vw - var(--container-wide)) / 2 + 1rem));
  width: clamp(33.5rem, 55vw, 51.5rem);
  max-width: none;
  overflow: visible;
  transform: translateY(-48%);
  animation: home-hero-system-enter 900ms var(--transition-base) both; }

.home-hero-system__diagram {
  transform-origin: center; }

.home-hero-system__grid path {
  fill: none;
  stroke: rgba(226, 250, 249, 0.052);
  stroke-width: 1; }

.home-hero-system__equipment--tank {
  opacity: 0.54; }

.home-hero-system__equipment--unit {
  opacity: 0.56; }

.home-hero-system__stand,
.home-hero-system__tank-detail,
.home-hero-system__unit-media,
.home-hero-system__pump-base,
.home-hero-system__pump-impeller,
.home-hero-system__monitor-line,
.home-hero-system__monitor-needle,
.home-hero-system__monitor-ticks {
  fill: none;
  stroke: rgba(218, 243, 242, 0.66);
  stroke-linecap: round;
  stroke-linejoin: round; }

.home-hero-system__stand {
  stroke-width: 5; }

.home-hero-system__tank-detail,
.home-hero-system__unit-media,
.home-hero-system__pump-base,
.home-hero-system__pump-impeller,
.home-hero-system__monitor-line,
.home-hero-system__monitor-needle,
.home-hero-system__monitor-ticks {
  stroke-width: 2.5; }

.home-hero-system__tank-body,
.home-hero-system__small-vessel,
.home-hero-system__unit-shell {
  stroke: rgba(235, 255, 254, 0.72);
  stroke-width: 2; }

.home-hero-system__tank-lip,
.home-hero-system__small-vessel-lip {
  fill: rgba(225, 247, 247, 0.26);
  stroke: rgba(235, 255, 254, 0.72);
  stroke-width: 2; }

.home-hero-system__tank-liquid {
  fill: rgba(45, 153, 154, 0.36); }

.home-hero-system__tank-line {
  fill: none;
  stroke: rgba(145, 224, 218, 0.72);
  stroke-width: 2; }

.home-hero-system__small-vessel {
  fill-opacity: 0.82; }

.home-hero-system__pump-motor,
.home-hero-system__pump-casing,
.home-hero-system__unit-shell,
.home-hero-system__check-body,
.home-hero-system__leak-sensor {
  stroke: rgba(226, 250, 249, 0.74);
  stroke-width: 2; }

.home-hero-system__monitor-face {
  fill: rgba(8, 39, 47, 0.82);
  stroke: rgba(226, 250, 249, 0.74);
  stroke-width: 2.5; }

.home-hero-system__pump-motor,
.home-hero-system__pump-casing {
  fill: rgba(8, 39, 47, 0.88); }

.home-hero-system__transfer-pump {
  opacity: 0.92; }

.home-hero-system__pipe-shell {
  fill: none;
  stroke: rgba(190, 220, 220, 0.7);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 20; }

.home-hero-system__pipe-core {
  fill: none;
  stroke: rgba(5, 38, 47, 0.96);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 10; }

.home-hero-system__pipe-highlight {
  fill: none;
  stroke: rgba(240, 255, 254, 0.52);
  stroke-linecap: round;
  stroke-width: 3; }

.home-hero-system__pipe-shell--bypass {
  stroke-width: 14;
  opacity: 0.7; }

.home-hero-system__pipe-core--bypass {
  stroke-width: 7; }

.home-hero-system__pipe-shell--branch {
  stroke: rgba(123, 201, 197, 0.64);
  opacity: 0.58;
  stroke-width: 10; }

.home-hero-system__pipe-core--branch {
  opacity: 0.86;
  stroke-width: 5; }

.home-hero-system__optional-branch {
  opacity: 0.58; }

.home-hero-system__containment {
  opacity: 0.54; }

.home-hero-system__containment-shell,
.home-hero-system__containment-core {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round; }

.home-hero-system__containment-shell {
  stroke: rgba(190, 220, 220, 0.42);
  stroke-width: 12; }

.home-hero-system__containment-core {
  stroke: rgba(114, 229, 218, 0.46);
  stroke-dasharray: 16 28;
  stroke-width: 3.5; }

.home-hero-system__flow {
  fill: none;
  stroke: rgba(123, 230, 219, 0.94);
  stroke-dasharray: 18 30;
  stroke-linecap: round;
  stroke-width: 4.5;
  animation: home-hero-flow 6s linear infinite; }

.home-hero-system__flow-arrows path {
  fill: rgba(123, 230, 219, 0.82);
  opacity: 0.78; }

.home-hero-system__small-valve path {
  fill: rgba(11, 57, 64, 0.92);
  stroke: rgba(226, 250, 249, 0.7);
  stroke-linejoin: round;
  stroke-width: 2; }

.home-hero-system__small-valve rect {
  fill: rgba(143, 196, 193, 0.82);
  stroke: rgba(226, 250, 249, 0.72);
  stroke-width: 2; }

.home-hero-system__module-frame {
  fill: rgba(8, 39, 47, 0.28);
  stroke: rgba(226, 250, 249, 0.2);
  stroke-width: 1.5; }

.home-hero-system__review {
  opacity: 0.84; }

.home-hero-system__review-panel {
  fill: rgba(8, 39, 47, 0.54);
  stroke: rgba(226, 250, 249, 0.18);
  stroke-width: 1.25; }

.home-hero-system__review-line {
  fill: none;
  stroke: rgba(226, 250, 249, 0.3);
  stroke-linecap: round;
  stroke-width: 2; }

.home-hero-system__review-text {
  fill: rgba(218, 243, 242, 0.78);
  font-size: 11px;
  font-weight: 700; }

.home-hero-system__review-meta {
  fill: rgba(156, 232, 224, 0.68);
  font-size: 10.5px;
  font-weight: 600; }

.home-hero-system__valve-package {
  opacity: 0.8; }

.home-hero-system__valve-stem,
.home-hero-system__valve-actuator {
  fill: rgba(164, 211, 207, 0.96);
  stroke: rgba(241, 255, 254, 0.9);
  stroke-width: 2.5; }

.home-hero-system__valve-body {
  stroke: rgba(248, 255, 254, 0.84);
  stroke-width: 2.5; }

.home-hero-system__valve-body-line {
  fill: none;
  stroke: rgba(7, 40, 48, 0.66);
  stroke-linecap: round;
  stroke-width: 6; }

.home-hero-system__valve-symbol {
  fill: rgba(7, 46, 54, 0.78);
  stroke: rgba(241, 255, 254, 0.72);
  stroke-linejoin: round;
  stroke-width: 2.5; }

.home-hero-system__valve-actuator-line {
  fill: none;
  stroke: rgba(230, 250, 249, 0.72);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2.5; }

.home-hero-system__check-symbol {
  fill: rgba(136, 210, 205, 0.9); }

.home-hero-system__check-stop {
  stroke: rgba(239, 255, 254, 0.78);
  stroke-linecap: round;
  stroke-width: 4; }

.home-hero-system__monitor-pulse {
  fill: rgba(114, 229, 218, 0.09);
  stroke: rgba(114, 229, 218, 0.54);
  stroke-width: 2;
  transform-box: fill-box;
  transform-origin: center;
  animation: home-hero-monitor-pulse 4.8s ease-in-out infinite; }

.home-hero-system__monitor--leak {
  opacity: 0.84; }

.home-hero-system__monitor--pressure {
  opacity: 0.96; }

.home-hero-system__leak-sensor-mark {
  fill: none;
  stroke: rgba(128, 226, 218, 0.7);
  stroke-linecap: round;
  stroke-width: 2; }

.home-hero-system__label,
.home-hero-system__review-text,
.home-hero-system__review-meta {
  font-family: var(--font-sans);
  letter-spacing: 0; }

.home-hero-system__label {
  fill: rgba(235, 255, 254, 0.78);
  font-size: 12px;
  font-weight: 700; }

.home-hero-system__label--secondary {
  fill: rgba(156, 232, 224, 0.68);
  font-size: 11px; }

.home-hero::after {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(90deg, rgba(7, 20, 34, 0.84) 0%, rgba(7, 20, 34, 0.78) 45%, rgba(7, 20, 34, 0.52) 58%, rgba(7, 20, 34, 0.12) 84%, rgba(7, 20, 34, 0.03) 100%), linear-gradient(0deg, rgba(7, 20, 34, 0.34), rgba(7, 20, 34, 0.02));
  content: ""; }

@keyframes home-hero-flow {
  to {
    stroke-dashoffset: -96; } }

@keyframes home-hero-monitor-pulse {
  0%,
  100% {
    opacity: 0.42;
    transform: scale(1); }
  50% {
    opacity: 0.82;
    transform: scale(1.16); } }

@keyframes home-hero-system-enter {
  from {
    opacity: 0;
    transform: translateY(-46%) translateX(1rem); }
  to {
    opacity: 1;
    transform: translateY(-48%) translateX(0); } }

@media (max-width: 47.999rem) {
  .home-hero {
    min-height: 39rem; }
  .home-hero__technical {
    background: radial-gradient(circle at 50% 55%, rgba(78, 194, 190, 0.32), transparent 46%), radial-gradient(circle at 88% 58%, rgba(95, 127, 58, 0.14), transparent 36%), linear-gradient(135deg, #07212a 0%, #0d3940 100%); }
  .home-hero__technical::before {
    background-size: 1.5rem 1.5rem;
    opacity: 0.28; }
  .home-hero__technical::after {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 22%), linear-gradient(0deg, rgba(3, 18, 25, 0.1), transparent 46%); }
  .home-hero::after {
    background: linear-gradient(180deg, rgba(7, 20, 34, 0.74) 0%, rgba(7, 20, 34, 0.58) 44%, rgba(7, 20, 34, 0.48) 100%), radial-gradient(ellipse at 50% 56%, rgba(7, 20, 34, 0.02) 0%, rgba(7, 20, 34, 0.12) 44%, rgba(7, 20, 34, 0.48) 100%); }
  .home-hero-system {
    top: 56%;
    right: auto;
    left: 50%;
    width: clamp(42rem, 190vw, 58rem);
    opacity: 0.64;
    transform: translate(-54%, -44%);
    animation: none; }
  .home-hero__content {
    text-shadow: 0 0.08rem 1.2rem rgba(3, 14, 20, 0.46); }
  .home-hero-system__equipment--unit {
    opacity: 0.46; }
  .home-hero-system__grid {
    opacity: 0.38; }
  .home-hero-system__bypass,
  .home-hero-system__optional-branch,
  .home-hero-system__review,
  .home-hero-system__containment,
  .home-hero-system__flow-arrows,
  .home-hero-system__monitor,
  .home-hero-system__label {
    display: none; }
  .home-hero-system__flow {
    opacity: 0.58;
    animation: none; } }

@media (prefers-reduced-motion: reduce) {
  .home-hero-system,
  .home-hero-system__flow,
  .home-hero-system__monitor-pulse {
    animation: none; }
  .home-hero-system__flow {
    opacity: 0.52;
    stroke-dashoffset: 0; } }

.home-hero__inner {
  --container: var(--container-wide);
  padding-block: calc(var(--space) * 5);
  padding-inline: clamp(1rem, 2.4vw, 1.75rem); }

.home-hero__content {
  display: grid;
  gap: calc(var(--space) * 1.5);
  justify-items: start;
  max-width: 38.5rem;
  color: white; }

.home-hero__kicker {
  color: color-mix(in oklab, var(--brand-light) 82%, white 18%);
  font-weight: 700;
  text-transform: uppercase; }

.home-hero__description {
  max-width: 35.5rem;
  color: color-mix(in oklab, white 82%, var(--brand-light) 18%);
  line-height: 1.62; }

.home-hero__bullets {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 1);
  max-width: 35rem; }

.home-hero__bullets li {
  padding: calc(var(--space) * 0.5) calc(var(--space) * 0.85);
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: var(--radius-pill);
  background-color: rgba(255, 255, 255, 0.1);
  color: white;
  font-size: 0.95rem; }

.home-hero__actions,
.home-cta__actions,
.section-page__cta,
.content-page__footer {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 1); }

.home-hero__actions {
  width: 100%;
  max-width: 35.5rem;
  margin-top: calc(var(--space) * 1.5); }

.home-hero__actions .button,
.home-cta__actions .button,
.section-page__cta .button,
.content-page__footer .button {
  flex: 1 1 12rem; }

.home-focus,
.home-process {
  background-color: color-mix(in oklab, var(--brand-light) 18%, var(--surface) 82%); }

.home-condition__panel {
  display: grid;
  gap: calc(var(--space) * 3);
  padding: calc(var(--space) * 3);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background: linear-gradient(135deg, color-mix(in oklab, var(--surface) 88%, white 12%), color-mix(in oklab, var(--brand-light) 18%, var(--surface) 82%)); }

.home-condition__intro {
  display: grid;
  gap: calc(var(--space) * 1);
  max-width: 42rem; }

.home-condition__intro p:last-child {
  color: var(--muted-text);
  line-height: 1.65; }

.condition-matrix {
  display: grid;
  border: var(--border);
  border-radius: var(--radius-m);
  overflow: hidden;
  background-color: color-mix(in oklab, var(--surface) 70%, white 30%); }

.condition-matrix__item {
  display: grid;
  gap: calc(var(--space) * 0.5);
  padding: calc(var(--space) * 1.5);
  border-bottom: var(--border); }

.condition-matrix__item:last-child {
  border-bottom: 0; }

.condition-matrix dt {
  color: var(--on-surface);
  font-weight: 700; }

.condition-matrix dd {
  color: var(--muted-text);
  line-height: 1.55; }

.process-list {
  display: grid;
  gap: calc(var(--space) * 2);
  counter-reset: process; }

.process-list__item {
  position: relative;
  display: grid;
  gap: calc(var(--space) * 1);
  padding: calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background-color: var(--card);
  counter-increment: process; }

.process-list__item::before {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-pill);
  background-color: var(--brand);
  color: var(--on-brand);
  content: counter(process, decimal-leading-zero);
  font-size: 0.8rem;
  font-weight: 700; }

.process-list__title {
  color: var(--on-surface); }

.process-list__text {
  color: var(--muted-text); }

.home-cta__panel {
  display: grid;
  gap: calc(var(--space) * 2);
  padding: calc(var(--space) * 3);
  border-radius: var(--radius-m);
  background-color: var(--brand);
  color: var(--on-brand); }

.home-cta__panel p {
  max-width: 68ch;
  color: color-mix(in oklab, var(--on-brand) 82%, var(--brand-light) 18%); }

.home-cta__actions .button--primary {
  border-color: color-mix(in oklab, white 90%, var(--brand-light) 10%);
  background-color: color-mix(in oklab, white 94%, var(--brand-light) 6%);
  color: var(--brand-dark);
  box-shadow: 0 0.75rem 1.8rem rgba(0, 0, 0, 0.14); }

.home-cta__actions .button--primary:hover {
  border-color: white;
  background-color: white;
  color: var(--brand-dark); }

.home-cta__actions .button--secondary {
  border-color: rgba(255, 255, 255, 0.48);
  background-color: rgba(255, 255, 255, 0.08);
  color: white; }

.home-cta__actions .button--secondary:hover {
  border-color: rgba(255, 255, 255, 0.72);
  background-color: rgba(255, 255, 255, 0.14);
  color: white; }

.section-page__hero,
.content-page__header,
.contact__header {
  display: grid;
  gap: calc(var(--space) * 1.5);
  max-width: 54rem; }

.section-page__hero {
  margin-inline: 0;
  text-align: left; }

.section-page .section__header,
.products-list .section__header,
.case-studies-list .section__header,
.insights-list .section__header {
  text-align: left; }

.section-page .section__description,
.products-list .section__description,
.case-studies-list .section__description,
.insights-list .section__description {
  margin-inline: 0; }

.section-page__eyebrow,
.content-page__eyebrow {
  color: var(--brand);
  font-weight: 700;
  text-transform: uppercase; }

.section-page__title,
.content-page__title,
.resources-page__title {
  color: var(--on-surface);
  line-height: 1.15; }

.section-page__description,
.content-page__description,
.resources-page__description {
  color: var(--muted-text);
  line-height: 1.65; }

.content-prose {
  color: var(--on-surface);
  line-height: 1.72; }

.content-prose a {
  color: var(--interactive-text);
  text-decoration: underline;
  text-decoration-color: color-mix(in oklab, var(--interactive-text) 34%, transparent);
  text-underline-offset: 0.18em;
  transition: color var(--transition-color), text-decoration-color var(--transition-color); }

.content-prose a:hover,
.content-prose a:focus-visible {
  color: var(--brand-dark);
  text-decoration-color: currentColor; }

.content-prose > * + * {
  margin-top: calc(var(--space) * 1.5); }

.content-prose h2,
.content-prose h3 {
  color: var(--on-surface);
  line-height: 1.25; }

.content-prose h2 {
  margin-top: calc(var(--space) * 3);
  font-size: 1.45rem; }

.content-prose h3 {
  font-size: 1.2rem; }

.content-prose ul,
.content-prose ol {
  padding-left: 1.25rem; }

.content-prose li + li {
  margin-top: calc(var(--space) * 0.75); }

.content-prose table {
  display: block;
  width: 100%;
  overflow-x: auto;
  border-collapse: collapse; }

.content-prose th,
.content-prose td {
  padding: calc(var(--space) * 0.9) calc(var(--space) * 1);
  border: var(--border);
  text-align: left;
  vertical-align: top; }

.content-prose th {
  background-color: color-mix(in oklab, var(--brand-light) 24%, var(--surface) 76%); }

.product-single__overview,
.about-hero__grid,
.contact__layout {
  display: grid;
  gap: calc(var(--space) * 3); }

.product-single__media,
.about-hero__media {
  overflow: hidden;
  border-radius: var(--radius-m);
  background: var(--img-bg);
  aspect-ratio: 16 / 9; }

.product-single__media .technical-visual {
  min-height: 100%; }

.product-single__image,
.about-hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover; }

.product-single__summary,
.product-single__details,
.product-single__specs,
.product-single__features,
.content-page__article,
.contact__form,
.contact__direct,
.content-page__form {
  display: grid;
  gap: calc(var(--space) * 2); }

.product-single__content {
  min-width: 0; }

.spec-list {
  display: grid;
  border: var(--border);
  border-radius: var(--radius-m);
  overflow: hidden;
  background-color: var(--card); }

.spec-list__item {
  display: grid;
  gap: calc(var(--space) * 0.5);
  padding: calc(var(--space) * 1.25);
  border-bottom: var(--border); }

.spec-list__item:last-child {
  border-bottom: 0; }

.spec-list dt {
  color: var(--muted-text);
  font-size: 0.9rem; }

.spec-list dd {
  color: var(--on-surface);
  font-weight: 600; }

.contact__form,
.contact__direct,
.content-page__form {
  padding: calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background-color: var(--card); }

.contact__direct-body {
  display: grid;
  gap: calc(var(--space) * 1.25); }

.contact__direct-item {
  display: grid;
  gap: calc(var(--space) * 0.35); }

.contact__direct-label {
  color: var(--brand);
  font-weight: 700; }

.contact__direct-value {
  color: var(--on-surface); }

.resources-page__article {
  display: grid;
  gap: calc(var(--space) * 2); }

.resources-page__layout {
  display: grid;
  gap: calc(var(--space) * 3); }

.resources-page__article {
  min-width: 0; }

.resources-page__media {
  overflow: hidden;
  border-radius: var(--radius-m);
  background-color: color-mix(in oklab, var(--brand-light) 18%, var(--surface) 82%);
  aspect-ratio: 16 / 7; }

.resources-page__image,
.resources-page__media .technical-visual {
  width: 100%;
  height: 100%; }

.resources-page__image {
  object-fit: cover; }

.resources-page__meta {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 1);
  color: var(--muted-text); }

.resources-page__content {
  max-width: 72ch; }

.resources-page__aside {
  display: grid;
  align-content: start;
  gap: calc(var(--space) * 2); }

.resources-page__aside-card,
.resources-page__toc {
  display: grid;
  gap: calc(var(--space) * 1.25);
  padding: calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background-color: var(--card); }

.resources-page__aside-card p {
  color: var(--muted-text);
  line-height: 1.6; }

.resources-page__toc nav,
.resources-page__toc ul {
  display: grid;
  gap: calc(var(--space) * 0.75); }

.resources-page__toc ul {
  padding-left: 0; }

.resources-page__toc li {
  list-style: none; }

.resources-page__toc a {
  color: var(--muted-text);
  font-size: 0.95rem;
  line-height: 1.45;
  transition: color var(--transition-color); }

.resources-page__toc a:hover,
.resources-page__toc a:focus-visible {
  color: var(--interactive-text); }

.selection-lens,
.review-strip,
.application-context,
.submission-guide,
.related-strip {
  display: grid;
  gap: calc(var(--space) * 2);
  padding: calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-m);
  box-shadow: var(--shadow);
  background-color: color-mix(in oklab, var(--surface) 86%, white 14%); }

.selection-lens__intro,
.review-strip__intro,
.application-context__body,
.submission-guide > div,
.related-strip > div {
  display: grid;
  gap: calc(var(--space) * 1); }

.selection-lens__intro p:last-child,
.review-strip__intro p:last-child,
.application-context__body p {
  color: var(--muted-text);
  line-height: 1.65; }

.selection-lens__list,
.signal-list,
.submission-guide__list,
.related-strip__list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75); }

.selection-lens__list li,
.signal-list li,
.submission-guide__list li {
  display: inline-flex;
  align-items: center;
  min-height: 2.25rem;
  padding: calc(var(--space) * 0.45) calc(var(--space) * 0.9);
  border: var(--border);
  border-radius: var(--radius-pill);
  background-color: color-mix(in oklab, var(--brand-light) 18%, var(--surface) 82%);
  color: color-mix(in oklab, var(--on-surface) 82%, var(--brand) 18%);
  font-size: 0.925rem; }

.review-strip__list {
  display: grid;
  gap: calc(var(--space) * 1); }

.review-strip__list li {
  display: grid;
  gap: calc(var(--space) * 0.5);
  padding: calc(var(--space) * 1.25);
  border: var(--border);
  border-radius: var(--radius-m);
  background-color: var(--card); }

.review-strip__list span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-pill);
  background-color: var(--brand);
  color: var(--on-brand);
  font-size: 0.8rem;
  font-weight: 700; }

.review-strip__list strong {
  color: var(--on-surface); }

.review-strip__list small {
  color: var(--muted-text);
  font-size: 0.9rem;
  line-height: 1.45; }

.application-context {
  padding: 0;
  overflow: hidden; }

.application-context__visual {
  min-height: 15rem; }

.application-context__visual .technical-visual {
  min-height: 100%; }

.application-context__body {
  padding: calc(var(--space) * 2); }

.related-strip__list a {
  display: inline-flex;
  align-items: center;
  min-height: 2.5rem;
  padding: calc(var(--space) * 0.55) calc(var(--space) * 1);
  border: var(--border);
  border-radius: var(--radius-s);
  color: var(--brand);
  font-weight: 600;
  text-decoration: none;
  transition: background-color var(--transition-color), border-color var(--transition-color), color var(--transition-color); }

.related-strip__list a:hover,
.related-strip__list a:focus-visible {
  border-color: var(--interactive-border-strong);
  background-color: var(--interactive-surface-quiet);
  color: var(--interactive-text); }

@media (min-width: 48rem) {
  .home-hero__inner {
    padding-block: calc(var(--space) * 7) calc(var(--space) * 6); }
  .home-hero__title {
    max-width: 18ch;
    font-size: 3.05rem; }
  .process-list {
    grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .spec-list {
    grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .condition-matrix {
    grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .condition-matrix__item:nth-child(odd) {
    border-right: var(--border); }
  .condition-matrix__item:nth-last-child(-n + 2) {
    border-bottom: 0; }
  .spec-list__item:nth-last-child(2):nth-child(odd) {
    border-bottom: 0; }
  .review-strip__list {
    grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .application-context {
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1fr); } }

@media (min-width: 80rem) {
  .process-list {
    grid-template-columns: repeat(4, minmax(0, 1fr)); } }

@media (min-width: 64rem) {
  .product-single__overview,
  .about-hero__grid {
    grid-template-columns: minmax(0, 0.95fr) minmax(22rem, 1fr);
    align-items: start; }
  .contact__layout {
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.75fr);
    align-items: start; }
  .product-single__overview {
    grid-template-columns: minmax(22rem, 0.85fr) minmax(0, 1fr); }
  .contact__header {
    grid-column: 1 / -1; }
  .home-condition__panel,
  .selection-lens,
  .related-strip {
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1fr);
    align-items: center; }
  .resources-page__layout {
    grid-template-columns: minmax(0, 1fr) 18rem;
    align-items: start; }
  .resources-page__aside {
    position: sticky;
    top: calc(var(--header-height) + calc(var(--space) * 2)); } }
