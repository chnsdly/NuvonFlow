@charset "UTF-8";
/* ==========================================================================
   Tokens
   --------------------------------------------------------------------------
   集中管理全站可复用的设计令牌
   ========================================================================== */
:root {
  /* ==========================================================================
     色彩
     ========================================================================== */
  --brand:        #1279e8;
  /* 品牌色 */
  --on-brand:     #FAFAF7;
  /* 品牌色上的文本/图标 */
  --surface:      #FAFAF7;
  /* 页面默认底色：提亮整体背景 */
  --on-surface:   #121212;
  /* 正文前景色 */
  --card:         color-mix(in oklab, var(--surface) 38%, white);
  --muted-text:       color-mix(in oklab, var(--on-surface) 60%, var(--surface) 40%);
  --img-bg: linear-gradient(to top, #EAF4FF 0%, #B9DAFA 50%, #76AFE8 100%);
  /* 透明图片的背景色 */
  /* ==========================================================================
     布局
     ========================================================================== */
  --container:        72rem;
  /* 默认：常规页面 */
  --container-wide:   80rem;
  /* 宽版：营销/视觉模块 */
  --container-narrow: 56rem;
  /* 窄版：以阅读为主 */
  --space: 0.5rem;
  /* 基准间距步长 */
  /* ==========================================================================
     外观
     ========================================================================== */
  --font-sans: "Inter", "Noto Sans SC", Arial, sans-serif;
  --border:       1px solid #E7E5DD;
  /* 全站统一边框 */
  --radius-s: 4px;
  /* 按钮、输入框、小标签 */
  --radius-m: 8px;
  /* 卡片 */
  --radius-l: 16px;
  /* 大面板 */
  --radius-pill: 999px;
  /* 胶囊 */
  --shadow: 0 1px 2px rgba(18, 18, 18, 0.03), 0 10px 28px rgba(18, 18, 18, 0.05);
  --shadow-hover: 0 2px 4px rgba(18, 18, 18, 0.04), 0 18px 40px rgba(18, 18, 18, 0.08);
  --shadow-inset: inset 0 1px 0 rgba(255, 255, 255, 0.32), inset 0 1px 2px rgba(18, 18, 18, 0.08), inset 0 0 0 1px rgba(18, 18, 18, 0.04);
  /* ==========================================================================
     交互
     ========================================================================== */
  --transition-base: 180ms cubic-bezier(0.22, 0.72, 0.18, 1);
  --focus-outline: 2px solid color-mix(in oklab, var(--brand) 45%, white);
  --focus-offset: 2px;
  --z-base: 0;
  /* 普通内容 */
  --z-header: 10;
  /* 吸顶头部 */
  --z-panel: 20;
  /* 下拉、弹出层、抽屉 */
  --z-modal: 30;
  /* 遮罩、弹窗这类最高层 */ }

/* ==========================================================================
   Mixins
   --------------------------------------------------------------------------
   集中管理可复用的 SCSS 工具方法，例如媒体查询、容器宽度、焦点状态、
   文字截断、无障碍动画降级等。

   这里只定义“写样式时可调用的工具”，不直接写具体页面、组件或布局样式。
   ========================================================================== */
/* 响应式断点 */
@font-face {
  font-family: "Inter";
  src: url("/fonts/Inter/InterVariable.ttf") format("truetype");
  font-weight: 400 700;
  font-style: normal;
  font-display: swap; }

@font-face {
  font-family: "Noto Sans SC";
  src: url("/fonts/NotoSansSC/NotoSansSCVariable.ttf") format("truetype");
  font-weight: 400 700;
  font-style: normal;
  font-display: swap; }

/* ==========================================================================
   Reset
   --------------------------------------------------------------------------
   统一浏览器默认样式差异，减少不同浏览器带来的不可控表现。

   这里只做必要的基础重置，例如盒模型、body 默认外边距、媒体元素显示、
   表单字体继承、图片自适应等。不要在这里写品牌视觉、页面布局或组件样式。
   ========================================================================== */
/* 1. 让元素的宽高包含 padding 和 border，布局更好计算 */
*,
*::before,
*::after {
  box-sizing: border-box; }

/* 2. 避免手机浏览器自动把文字放大，减少移动端显示异常 */
html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%; }

/* 3. 去掉页面四周默认空白 */
body {
  margin: 0; }

/* 4. 去掉常见文字元素的默认外边距，避免版面出现不可控空隙
   注意：不动普通 ul / ol，文章里的列表仍然保留缩进和圆点 */
h1,
h2,
h3,
h4,
h5,
h6,
p,
figure,
blockquote,
dl,
dd {
  margin: 0; }

a {
  color: inherit;
  text-decoration: none; }

/* 5. 带 class 的列表通常是导航、卡片、菜单等组件，不需要默认圆点和缩进 */
:where(ul[class], ol[class]) {
  margin: 0;
  padding: 0;
  list-style: none; }

/* 6. 图片、视频等媒体元素不要超出父容器，避免撑破页面 */
img,
picture,
video,
canvas {
  display: block;
  max-width: 100%; }

/* 7. 图片按原比例缩放，不被拉伸变形 */
img {
  height: auto; }

/* 8. 表单里的输入框、按钮等，使用和页面一致的字体 */
input,
button,
textarea,
select {
  font: inherit; }

/* 9. 合并表格边框，方便后续统一控制表格样式 */
table {
  border-collapse: collapse;
  border-spacing: 0; }

/* 10. 文本输入框只允许上下拉伸，避免左右拉伸撑坏布局 */
textarea {
  resize: vertical; }

/* 11. 遇到很长的型号、链接、参数时，允许自动换行，避免出现横向滚动 */
:where(h1, h2, h3, h4, h5, h6, p, a, li, dt, dd, figcaption, th, td) {
  overflow-wrap: break-word; }

/* 12. 键盘操作时保留清晰的焦点提示，方便无障碍访问 */
:focus-visible {
  outline: var(--focus-outline, 2px solid currentColor);
  outline-offset: var(--focus-offset, 2px); }

/* 13. 如果用户系统设置了“减少动态效果”，就尽量关闭动画和过渡 */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important; } }

/* ==========================================================================
   Base
   --------------------------------------------------------------------------
   这里存放全站的基础样式，用来定义网站默认的视觉起点。

   一般放：
   - body 的字体、字号、行高、文字颜色、背景色
   - h1-h6、p、small、strong 等基础文字元素
   - a 链接的默认颜色、悬停效果
   - img、svg 等媒体元素的默认表现
   - ul、ol、blockquote、hr、code 等常见内容元素
   - .container 这类全站通用基础容器
   - section、main 等常见结构元素的基础间距
   - 少量全站通用的辅助类（如果不单独拆 helpers）

   ========================================================================== */
body {
  font-family: var(--font-sans);
  font-weight: 400;
  background-color: var(--surface); }

.container {
  box-sizing: border-box;
  max-width: var(--container);
  width: 100%;
  margin-inline: auto;
  padding-inline: calc(var(--space) * 1); }

/* 在 .container 后面使用，保证能覆盖 */
.container--wide {
  --container: var(--container-wide); }

.container--narrow {
  --container: var(--container-narrow); }

.font-meta {
  font-size: 0.875rem;
  font-weight: 400; }

.font-body {
  font-size: 1rem;
  font-weight: 400; }

.font-title-xs {
  font-size: 1.25rem;
  font-weight: 400; }

.font-title-s {
  font-size: 1.5rem;
  font-weight: 600; }

.font-title-l {
  font-size: 1.75rem;
  font-weight: 600; }

.font-display {
  font-size: 2.5rem;
  font-weight: 700; }

.section {
  position: relative;
  padding-block: calc(var(--space) * 4); }

.section__inner {
  display: grid;
  gap: calc(var(--space) * 3); }

.section__header {
  display: grid;
  gap: calc(var(--space) * 2);
  text-align: center; }

.section__title {
  color: var(--on-surface); }

.section__description {
  margin: 0 auto;
  max-width: 120ch;
  color: var(--muted-text); }

.site-header {
  position: sticky;
  top: 0;
  z-index: var(--z-header);
  background-color: var(--surface);
  box-shadow: var(--shadow); }

.site-header__inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  padding: 0 calc(var(--space) * 3);
  gap: calc(var(--space) * 2);
  min-height: 4.5rem; }

.site-header__logo {
  display: inline-flex;
  align-items: center;
  gap: calc(var(--space) * 1);
  min-width: 0;
  min-height: 2.75rem;
  color: var(--on-surface);
  font-weight: 700; }

.site-header__logo:focus-visible {
  border-radius: var(--radius-s); }

.site-header__logo-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: var(--radius-s);
  background-color: var(--brand);
  color: var(--on-brand);
  font-size: 0.85rem;
  box-shadow: var(--shadow-inset); }

.site-header__logo-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; }

.site-header__nav,
.site-header__cta.button {
  display: none; }

.site-header__mobile {
  justify-self: end; }

.site-header__mobile[open] .site-header__toggle {
  border-color: color-mix(in oklab, var(--brand) 42%, var(--surface) 58%);
  background-color: var(--surface);
  color: var(--brand); }

.site-header__mobile[open] .site-header__toggle-line:nth-child(1) {
  transform: translateY(0.4375rem) rotate(45deg); }

.site-header__mobile[open] .site-header__toggle-line:nth-child(2) {
  opacity: 0; }

.site-header__mobile[open] .site-header__toggle-line:nth-child(3) {
  transform: translateY(-0.4375rem) rotate(-45deg); }

.site-header__toggle {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.3125rem;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0.625rem;
  background-color: var(--surface);
  color: var(--on-surface);
  cursor: pointer;
  list-style: none;
  transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base); }

.site-header__toggle::-webkit-details-marker {
  display: none; }

.site-header__toggle-line {
  display: block;
  width: 100%;
  height: 0.125rem;
  border-radius: var(--radius-pill);
  background-color: currentColor;
  transition: opacity var(--transition-base), transform var(--transition-base); }

.site-header__mobile-panel {
  position: absolute;
  top: calc(100% + 1px);
  right: calc(var(--space) * 0);
  left: calc(var(--space) * 0);
  display: grid;
  gap: calc(var(--space) * 3);
  max-height: calc(100vh - 4.5rem - calc(var(--space) * 2));
  padding: calc(var(--space) * 1.5);
  overflow-y: auto;
  background-color: var(--surface); }

.site-header__mobile-menu {
  display: grid; }

.site-header__mobile-item {
  border-radius: var(--radius-s);
  background-color: var(--surface);
  padding-block: calc(var(--space) * 1.5); }

.site-header__mobile-item.is-active {
  border-color: color-mix(in oklab, var(--brand) 42%, var(--surface) 58%); }

.site-header__mobile-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--space) * 1);
  padding: calc(var(--space) * 1) calc(var(--space) * 1.25);
  color: var(--on-surface);
  cursor: pointer; }

.site-header__mobile-summary::-webkit-details-marker {
  display: none; }

.site-header__mobile-section[open] .site-header__mobile-summary {
  color: var(--brand); }

.site-header__mobile-chevron {
  transition: transform var(--transition-base); }

.site-header__mobile-section[open] .site-header__mobile-chevron {
  transform: rotate(180deg); }

.site-header__mobile-submenu {
  display: grid;
  padding: calc(var(--space) * 2) calc(var(--space) * 2); }

.site-header__mobile-section[open] .site-header__mobile-submenu {
  background-color: color-mix(in oklab, var(--brand) 9%, var(--surface) 91%); }

.site-header__mobile-link {
  display: block;
  padding: calc(var(--space) * 2) calc(var(--space) * 1);
  border-radius: var(--radius-s);
  color: var(--muted-text); }

.site-header__mobile-link:hover,
.site-header__mobile-link:focus-visible,
.site-header__mobile-link[aria-current="page"] {
  background-color: color-mix(in oklab, var(--brand) 10%, var(--surface) 90%);
  color: var(--brand); }

.site-header__mobile-link--hub {
  color: var(--on-surface);
  font-weight: 500; }

.site-header__mobile-footer {
  display: grid;
  gap: calc(var(--space) * 1.5);
  padding-top: calc(var(--space) * 1.5);
  border-top: var(--border); }

.site-header__language {
  display: grid;
  gap: calc(var(--space) * 0.75); }

.site-header__language-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75); }

.site-header__language-link {
  display: inline-flex;
  align-items: center;
  min-height: 2.25rem;
  padding: calc(var(--space) * 0.5) calc(var(--space) * 1);
  border: var(--border);
  border-radius: var(--radius-pill);
  color: var(--muted-text);
  font-size: 0.95rem;
  transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base); }

.site-header__language-link:hover,
.site-header__language-link:focus-visible,
.site-header__language-link.is-active {
  border-color: color-mix(in oklab, var(--brand) 38%, var(--surface) 62%);
  background-color: color-mix(in oklab, var(--brand) 9%, var(--surface) 91%);
  color: var(--brand); }

@media (min-width: 64rem) {
  .site-header__inner {
    grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr); }
  .site-header__nav {
    display: block;
    justify-self: center; }
  .site-header__menu {
    display: flex;
    align-items: center;
    gap: calc(var(--space) * 2); }
  .site-header__item {
    position: relative; }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space) * 0.5);
    min-height: 2.75rem;
    padding: calc(var(--space) * 0.75) calc(var(--space) * 1);
    border-radius: var(--radius-s);
    color: var(--on-surface);
    white-space: nowrap;
    transition: background-color var(--transition-base), color var(--transition-base); }
  .site-header__link:hover,
  .site-header__link:focus-visible,
  .site-header__item.is-active > .site-header__link {
    background-color: color-mix(in oklab, var(--brand) 9%, var(--surface) 91%);
    color: var(--brand); }
  .site-header__chevron {
    color: currentColor;
    font-size: 0.85em;
    line-height: 1;
    transition: transform var(--transition-base); }
  .site-header__item--has-children:hover .site-header__chevron,
  .site-header__item--has-children:focus-within .site-header__chevron {
    transform: rotate(180deg); }
  .site-header__submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: var(--z-panel);
    display: grid;
    min-width: 16rem;
    padding: calc(var(--space) * 1.5);
    border-radius: var(--radius-m);
    background-color: var(--surface);
    box-shadow: var(--shadow-hover);
    opacity: 0;
    transform: translate(-50%, -0.25rem);
    visibility: hidden;
    transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base); }
  .site-header__item--has-children:hover > .site-header__submenu,
  .site-header__item--has-children:focus-within > .site-header__submenu {
    opacity: 1;
    transform: translate(-50%, 0);
    visibility: visible; }
  .site-header__submenu-link {
    display: block;
    padding: calc(var(--space) * 1.5) calc(var(--space) * 1);
    border-radius: var(--radius-s);
    color: var(--muted-text);
    font-size: 0.95rem;
    white-space: nowrap;
    transition: background-color var(--transition-base), color var(--transition-base); }
  .site-header__submenu-link:hover,
  .site-header__submenu-link:focus-visible,
  .site-header__submenu-link[aria-current="page"] {
    background-color: color-mix(in oklab, var(--brand) 9%, var(--surface) 91%);
    color: var(--brand); }
  .site-header__cta.button {
    display: inline-flex;
    justify-self: end;
    width: fit-content;
    white-space: nowrap; }
  .site-header__mobile {
    display: none; } }

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: calc(var(--space) * 0.75);
  min-height: 2.75rem;
  padding: calc(var(--space) * 0.75) calc(var(--space) * 2);
  border: var(--border);
  border-radius: var(--radius-s);
  font: inherit;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  vertical-align: middle;
  appearance: none;
  user-select: none;
  cursor: pointer;
  transition: background-color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), color var(--transition-base), opacity var(--transition-base), transform var(--transition-base); }

.button:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.button:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):active {
  transform: translateY(1px); }

.button:disabled,
.button[aria-disabled="true"],
.button.is-disabled {
  box-shadow: none;
  cursor: not-allowed;
  opacity: 0.55;
  pointer-events: none;
  transform: none; }

.button__icon,
.button > svg {
  display: inline-flex;
  flex: 0 0 auto;
  width: 1.125em;
  height: 1.125em; }

.button__icon svg {
  display: block;
  width: 100%;
  height: 100%; }

.button__text {
  min-width: 0; }

.button--primary {
  border-color: var(--brand);
  background-color: var(--brand);
  color: var(--on-brand);
  box-shadow: var(--shadow-inset); }

.button--primary:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):hover {
  border-color: color-mix(in oklab, var(--brand) 84%, var(--on-surface) 16%);
  background-color: color-mix(in oklab, var(--brand) 88%, var(--on-surface) 12%);
  color: var(--on-brand);
  box-shadow: var(--shadow-hover); }

.button--secondary {
  border-color: color-mix(in oklab, var(--brand) 42%, var(--surface) 58%);
  background-color: color-mix(in oklab, var(--surface) 92%, white 8%);
  color: var(--brand); }

.button--secondary:where(:not(:disabled):not([aria-disabled="true"]):not(.button--disabled)):hover {
  border-color: var(--brand);
  background-color: color-mix(in oklab, var(--brand) 10%, var(--surface) 90%);
  color: color-mix(in oklab, var(--brand) 84%, var(--on-surface) 16%); }

.button--full {
  width: 100%; }

.breadcrumbs {
  padding-block: calc(var(--space) * 1);
  border-bottom: 1px solid #E7E5DD; }

.breadcrumbs__list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: calc(var(--space) * 0.75);
  color: var(--muted-text); }

.breadcrumbs__item {
  display: inline-flex;
  align-items: center;
  min-width: 0; }

.breadcrumbs__item + .breadcrumbs__item::before {
  content: "›";
  margin-right: calc(var(--space) * 0.75);
  color: color-mix(in oklab, var(--muted-text) 70%, var(--surface) 30%); }

.breadcrumbs__link,
.breadcrumbs__current {
  font-size: 0.875rem;
  line-height: 1.4; }

.breadcrumbs__link {
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-s);
  color: inherit;
  transition: color var(--transition-base), background-color var(--transition-base), transform var(--transition-base); }

.breadcrumbs__link:hover,
.breadcrumbs__link:focus-visible {
  color: var(--brand); }

.breadcrumbs__link:focus-visible {
  outline: var(--focus-outline);
  outline-offset: var(--focus-offset); }

.breadcrumbs__link:active {
  transform: translateY(1px); }

.breadcrumbs__link[aria-disabled="true"],
.breadcrumbs__link:disabled,
.breadcrumbs__link--disabled {
  opacity: 0.5;
  pointer-events: none; }

.breadcrumbs__current {
  color: var(--on-surface);
  font-weight: 500;
  overflow-wrap: anywhere; }
